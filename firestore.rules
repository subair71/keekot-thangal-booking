rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() { return request.auth != null; }
    function owner(uid) { return signedIn() && request.auth.uid == uid; }
    function admin() { return signedIn() && request.auth.token.admin == true; }
    function khadimAccess(permission) {
      let staff = get(/databases/$(database)/documents/khadims/$(request.auth.uid)).data;
      return signedIn() && staff.enabled == true
        && request.auth.token.khadimVersion == staff.version
        && permission in staff.permissions;
    }
    match /khadims/{uid} { allow read: if owner(uid) || admin(); allow write: if false; }
    match /settings/booking { allow read: if true; allow write: if false; }
    match /closures/{id} { allow read: if true; allow write: if false; }
    match /visitSlots/{id} { allow read: if true; allow write: if false; }
    match /users/{uid} {
      allow read: if owner(uid) || admin();
      allow create, update: if owner(uid)
        && request.resource.data.keys().hasOnly(['displayName', 'updatedAt'])
        && request.resource.data.displayName is string
        && request.resource.data.displayName.size() <= 100
        && request.resource.data.updatedAt == request.time;
      allow delete: if false;
      match /devices/{id} { allow read, write: if false; }
    }
    match /bookings/{id} { allow read: if owner(resource.data.userId) || admin() || khadimAccess('bookings'); allow write: if false; }
    match /slotHolds/{id} { allow read: if owner(resource.data.userId); allow write: if false; }
    match /activeUserHolds/{uid} { allow read: if owner(uid); allow write: if false; }
    match /notifications/{id} {
      allow read: if owner(resource.data.userId);
      allow update: if owner(resource.data.userId)
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['read'])
        && request.resource.data.read == true;
      allow create, delete: if false;
    }
    match /auditLog/{id} { allow read: if admin(); allow write: if false; }
    match /{document=**} { allow read, write: if false; }
  }
}
