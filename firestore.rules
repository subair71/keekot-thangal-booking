rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() { return request.auth != null; }
    function owner(uid) { return signedIn() && request.auth.uid == uid; }
    function admin() { return signedIn() && request.auth.token.admin == true; }
    function khadimAccess(permission) {
      let staff = get(/databases/$(database)/documents/khadims/$(request.auth.uid)).data;
      return signedIn() && staff.enabled == true
        && request.auth.token.khadimVersion == staff.version
        && permission in staff.permissions;
    }
    function validKhadim() {
      let staff = get(/databases/$(database)/documents/khadims/$(request.auth.uid)).data;
      return signedIn() && staff.enabled == true && request.auth.token.khadimVersion == staff.version;
    }
    function bookingOwner(uid) {
      return owner(uid) && (!('khadimVersion' in request.auth.token) || validKhadim());
    }
    match /khadimSchedules/{id} { allow read: if admin() || (validKhadim() && resource.data.khadimId == request.auth.uid); allow write: if false; }
    match /assignmentHistory/{id} { allow read: if admin(); allow write: if false; }
    match /khadims/{uid} { allow read: if owner(uid) || admin(); allow write: if false; }
    function validHomeNotice() {
      let notice = request.resource.data.homeNotice;
      return notice is map
        && notice.keys().hasAll(['visitDate', 'reason', 'active', 'updatedAt', 'updatedBy'])
        && notice.keys().hasOnly(['visitDate', 'reason', 'active', 'updatedAt', 'updatedBy'])
        && notice.visitDate is string
        && notice.visitDate.matches('^[0-9]{4}-[0-9]{2}-[0-9]{2}
    match /settings/sms { allow read, write: if admin(); }
    // Public links are bearer capabilities: a known token may read one pass,
    // but queries must never enumerate passes or visitor details.
    match /publicPasses/{token} { allow get: if true; allow list, write: if false; }
    match /closures/{id} { allow read: if true; allow write: if false; }
    match /visitSlots/{id} { allow read: if true; allow write: if false; }
    match /users/{uid} {
      allow read: if owner(uid) || admin();
      allow create, update: if owner(uid)
        && request.resource.data.keys().hasOnly(['displayName', 'updatedAt'])
        && request.resource.data.displayName is string
        && request.resource.data.displayName.size() <= 100
        && request.resource.data.updatedAt == request.time;
      allow delete: if false;
      match /devices/{id} { allow read, write: if false; }
    }
    match /bookings/{id} { allow read: if bookingOwner(resource.data.userId) || admin() || (resource.data.assignment.khadimId == request.auth.uid && validKhadim()); allow write: if false; }
    match /slotHolds/{id} { allow read: if bookingOwner(resource.data.userId); allow write: if false; }
    match /activeUserHolds/{uid} { allow read: if bookingOwner(uid); allow write: if false; }
    match /notifications/{id} {
      allow read: if bookingOwner(resource.data.userId);
      allow update: if bookingOwner(resource.data.userId)
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['read'])
        && request.resource.data.read == true;
      allow create, delete: if false;
    }
    match /auditLog/{id} { allow read: if admin(); allow write: if false; }
    match /{document=**} { allow read, write: if false; }
  }
}
)
        && notice.reason is string && notice.reason.size() > 0 && notice.reason.size() <= 500
        && notice.active is bool
        && notice.updatedAt == request.time
        && notice.updatedBy == request.auth.uid;
    }
    match /settings/booking {
      allow read: if true;
      allow update: if admin()
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['homeNotice'])
        && validHomeNotice();
      allow create, delete: if false;
    }
    match /settings/sms { allow read, write: if admin(); }
    // Public links are bearer capabilities: a known token may read one pass,
    // but queries must never enumerate passes or visitor details.
    match /publicPasses/{token} { allow get: if true; allow list, write: if false; }
    match /closures/{id} { allow read: if true; allow write: if false; }
    match /visitSlots/{id} { allow read: if true; allow write: if false; }
    match /users/{uid} {
      allow read: if owner(uid) || admin();
      allow create, update: if owner(uid)
        && request.resource.data.keys().hasOnly(['displayName', 'updatedAt'])
        && request.resource.data.displayName is string
        && request.resource.data.displayName.size() <= 100
        && request.resource.data.updatedAt == request.time;
      allow delete: if false;
      match /devices/{id} { allow read, write: if false; }
    }
    match /bookings/{id} { allow read: if bookingOwner(resource.data.userId) || admin() || (resource.data.assignment.khadimId == request.auth.uid && validKhadim()); allow write: if false; }
    match /slotHolds/{id} { allow read: if bookingOwner(resource.data.userId); allow write: if false; }
    match /activeUserHolds/{uid} { allow read: if bookingOwner(uid); allow write: if false; }
    match /notifications/{id} {
      allow read: if bookingOwner(resource.data.userId);
      allow update: if bookingOwner(resource.data.userId)
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['read'])
        && request.resource.data.read == true;
      allow create, delete: if false;
    }
    match /auditLog/{id} { allow read: if admin(); allow write: if false; }
    match /{document=**} { allow read, write: if false; }
  }
}
